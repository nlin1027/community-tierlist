# Copy to .env in the repo root and fill in. .env is gitignored.
# Only VITE_* vars reach the browser. Never put secrets behind VITE_.

# Supabase Postgres (Dashboard -> Connect -> session pooler, port 5432)
DATABASE_URL=

# Redis (Render Key Value, use the EXTERNAL url)
REDIS_URL=

# API server
NODE_ENV=
PORT=

# Frontend (Vite)
VITE_API_URL_LOCAL=
VITE_API_URL_PROD=
